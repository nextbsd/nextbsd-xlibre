Description: mouse.h: the fields the FreeBSD backend and options need.
 Adds disableXY, hasZ and hasW (the backend says whether the device has
 vertical and horizontal wheels) and moves fracdx/fracdy and sensitivity
 into MouseDevRec, where 0002-0003 use them. Unchanged from the port.
Origin: FreeBSD ports, x11-drivers/xlibre-xf86-input-mouse/files/patch-src_mouse.h
 (https://github.com/freebsd/freebsd-ports/blob/efd79beed9576dd3e354f889a41dabd5890921f4/x11-drivers/xlibre-xf86-input-mouse/files/patch-src_mouse.h)
Forwarded: not yet; a candidate for X11Libre (FreeBSD support)
---
diff -ruN a/src/mouse.h b/src/mouse.h
--- a/src/mouse.h
+++ b/src/mouse.h
@@ -220,10 +220,13 @@
     Bool                emulate3ButtonsSoft;
     int                 emulate3Timeout;/* Timeout for 3 button emulation */
     Bool                chordMiddle;
+    Bool                disableXY;
     Bool                flipXY;
     int                 invX;
     int                 invY;
     int                 resolution;
+    Bool                hasW;
+    Bool                hasZ;
     int                 negativeZ;      /* button mask */
     int                 positiveZ;      /* button mask */
     int                 negativeW;      /* button mask */
@@ -262,6 +265,8 @@
     int                 doubleClickOldSourceState;
     int                 lastMappedButtons;
     int                 buttonMap[MSE_MAXBUTTONS];
+    float               fracdx,fracdy;
+    float               sensitivity;
 } MouseDevRec, *MouseDevPtr;
 
 #endif /* _XF86OSMOUSE_H_ */
