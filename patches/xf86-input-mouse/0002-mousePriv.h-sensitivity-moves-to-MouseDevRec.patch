Description: mousePriv.h: drop fracdx, fracdy and sensitivity.
 They move to MouseDevRec (0001), so the Sensitivity option also works
 for protocols that have no mousePriv (sysmouse, usb). Unchanged from the
 port.
Origin: FreeBSD ports, x11-drivers/xlibre-xf86-input-mouse/files/patch-src_mousePriv.h
 (https://github.com/freebsd/freebsd-ports/blob/efd79beed9576dd3e354f889a41dabd5890921f4/x11-drivers/xlibre-xf86-input-mouse/files/patch-src_mousePriv.h)
Forwarded: not yet; a candidate for X11Libre (FreeBSD support)
---
diff -ruN a/src/mousePriv.h b/src/mousePriv.h
--- a/src/mousePriv.h
+++ b/src/mousePriv.h
@@ -63,8 +63,6 @@
     int         acc;
     CARD32      pnpLast;
     Bool        disablePnPauto;
-    float       fracdx,fracdy;
-    float       sensitivity;
 } mousePrivRec, *mousePrivPtr;
 
 /* mouse proto flags */
