+#ifndef WIN32
+/* A launchd socket may skip X authorization only when it sits in a directory
+ * that nobody but the user who started the server can enter (the real uid;
+ * a set-uid Xorg runs with root's effective uid), as SecureSocketWithKey's
+ * mkdtemp(3) directory does; XQuartz relies on the same property. */
+static Bool
+LaunchdSocketIsPrivate(int fd)
+{
+    struct sockaddr_un addr;
+    socklen_t len = sizeof(addr);
+    struct stat st;
+    char *slash;
+
+    memset(&addr, 0, sizeof(addr));
+    if (getsockname(fd, (struct sockaddr *) &addr, &len) != 0 ||
+        addr.sun_family != AF_UNIX)
+        return FALSE;
+    addr.sun_path[sizeof(addr.sun_path) - 1] = '\0';
+    slash = strrchr(addr.sun_path, '/');
+    if (slash == NULL || slash == addr.sun_path)
+        return FALSE;
+    *slash = '\0';
+    return stat(addr.sun_path, &st) == 0 && S_ISDIR(st.st_mode) &&
+        st.st_uid == getuid() && (st.st_mode & (S_IRWXG | S_IRWXO)) == 0;
+}
+
+/* -launchd <name>: take the listening sockets of the job's launchd Sockets
+ * entry <name> (launch_activate_socket(3)) instead of creating our own, so
+ * launchd can start the server when the first client connects (the XQuartz
+ * launch model). liblaunch is loaded only here, so a server started any other
+ * way neither links nor loads it. */
+static void
+ListenOnLaunchdSockets(void)
+{
+    int (*activate)(const char *, int **, size_t *);
+    void *handle;
+    int *fds = NULL;
+    size_t cnt = 0, i;
+    int err;
+
+    handle = dlopen("liblaunch.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (handle == NULL)
+        handle = dlopen("/usr/lib/system/liblaunch.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (handle == NULL)
+        FatalError("-launchd: cannot load liblaunch: %s\n", dlerror());
+    activate = (int (*)(const char *, int **, size_t *))
+        dlsym(handle, "launch_activate_socket");
+    if (activate == NULL)
+        FatalError("-launchd: liblaunch has no launch_activate_socket\n");
+    err = activate(LaunchdSocketName, &fds, &cnt);
+    if (err != 0)
+        FatalError("-launchd: no launchd sockets named \"%s\": %s\n",
+                   LaunchdSocketName, strerror(err));
+    for (i = 0; i < cnt; i++) {
+        Bool noxauth = LaunchdSocketIsPrivate(fds[i]);
+
+        if (!noxauth)
+            LogMessage(X_WARNING, "launchd socket %d is not in a private "
+                       "directory; X authorization applies to it\n", fds[i]);
+        ListenOnOpenFD(fds[i], noxauth);
+    }
+    free(fds);
+    if (ListenTransCount == 0)
+        FatalError("-launchd: could not listen on the sockets named \"%s\"\n",
+                   LaunchdSocketName);
+}
+#endif
+
 /*****************
  * CreateWellKnownSockets
  *    At initialization, create the sockets to listen on for new clients.
@@ -248,6 +321,14 @@ CreateWellKnownSockets(void)
     /* display is initialized to "0" by main(). It is then set to the display
      * number if specified on the command line. */
 
+#ifndef WIN32
+    if (LaunchdSocketName) {
+        ListenTransCount = 0;
+        ListenOnLaunchdSockets();
+        goto listening;
+    }
+#endif
+
     if (NoListenAll) {
         ListenTransCount = 0;
     }
@@ -297,6 +378,9 @@ CreateWellKnownSockets(void)
         FatalError
             ("Cannot establish any listening sockets - Make sure an X server isn't already running");
 
+#ifndef WIN32
+ listening:
+#endif
 #if !defined(WIN32)
     OsSignal(SIGPIPE, SIG_IGN);
 #endif
